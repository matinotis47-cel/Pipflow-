# PIPFLOW (https://pipflow.site) Environment Configuration

# GEMINI_API_KEY: Required for server-side Gemini AI bot generation & market insights.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where PIPFLOW is hosted (e.g. https://pipflow.site or your Render URL).
APP_URL="https://pipflow.site"

# PORT: Render automatically injects PORT at runtime (defaults to 3000 locally).
PORT="3000"

# AUTH_SECRET: 32+ char secret key used to sign HTTP-only session cookies.
AUTH_SECRET="replace-with-32-char-random-secret"

# TOKEN_ENCRYPTION_KEY: 32+ char secret used for AES-256-GCM encryption of Deriv tokens at rest in Neon.
TOKEN_ENCRYPTION_KEY="replace-with-32-char-encryption-key"

# PIPFLOW_ADMIN_PASSWORD_HASH: Optional salted scrypt hash ("salt:hash") for /admin access.
PIPFLOW_ADMIN_PASSWORD_HASH=""

# NEON POSTGRESQL DATABASE (Primary persistent DB on Render)
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# OPTIONAL SUPABASE CLIENT (If also mirroring to Supabase Postgres/Auth)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# OFFICIAL DERIV API INTEGRATION (Strict Read-Only Account Verification & Public Market Data)
# Registered Deriv App ID (https://app.deriv.com -> Application Manager)
DERIV_APP_ID="1089"
# Optional OAuth 2.0 Client Secret (if confidential client enabled in app.deriv.com)
DERIV_CLIENT_SECRET=""
# Exact OAuth Redirect URI registered on Deriv (e.g. https://yourapp.onrender.com/auth/callback)
DERIV_REDIRECT_URI="https://pipflow.site/auth/callback"
# Deriv Modern Auth & REST API Base URLs (PKCE OAuth2 uses scope=read only)
DERIV_AUTH_BASE="https://auth.deriv.com"
DERIV_API_BASE="https://api.deriv.com"
# Optional Read-Only Deriv PAT for diagnostic health telemetry (never used for order execution)
DERIV_API_TOKEN=""

# BREVO TRANSACTIONAL EMAIL API (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@pipflow.site"
BREVO_SENDER_NAME="PIPFLOW Trading"

# ANDROID / WEB PUSH NOTIFICATIONS (VAPID KEYS)
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@pipflow.site"
