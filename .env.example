# GEMINI_API_KEY: Required for server-side Gemini AI bot generation & market insights.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where PIPFLOW is hosted (e.g. https://pipflow.site).
APP_URL="https://pipflow.site"

# AUTH_SECRET: Secret key used to sign HTTP-only session cookies.
AUTH_SECRET="replace-with-32-char-random-secret"

# PIPFLOW_ADMIN_PASSWORD_HASH: Salted scrypt hash ("salt:hash") or bcrypt hash for /admin authentication.
# Leave unset on first launch to initialize securely via the hidden 10-click Admin modal.
PIPFLOW_ADMIN_PASSWORD_HASH=""

# Optional PostgreSQL / Neon connection string for external standalone deployments
DATABASE_URL=""

# Optional SMTP email configuration for verification & password reset emails
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@pipflow.site"
