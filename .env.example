# Runtime
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Required on Render production. Use the Neon pooled connection string and require TLS.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin: supply a scrypt/bcrypt password hash; never commit a plaintext password.
PIPFLOW_ADMIN_PASSWORD_HASH=""

# Deriv OAuth (not enabled until the application is registered and redirect URL is approved).
DERIV_CLIENT_ID=""
DERIV_CLIENT_SECRET=""
DERIV_REDIRECT_URI="https://your-render-service.onrender.com/api/deriv/callback"
DERIV_OAUTH_URL=""
DERIV_TOKEN_URL=""
DERIV_API_URL=""

# Transactional email via Brevo
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="PIPFLOW"

# Firebase Admin credentials for Android push (service account values from Firebase Console).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Optional AI service
GEMINI_API_KEY=""

# Optional legacy SMTP configuration
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@example.com"
