rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'country', 'phone', 'emailVerified', 'status', 'preferredTheme', 'preferredCurrency', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.status in ['active', 'suspended']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 120))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('preferredTheme' in data) || data.preferredTheme in ['light', 'dark'])
        && (!('preferredCurrency' in data) || (data.preferredCurrency is string && data.preferredCurrency.size() <= 10));
    }

    function isValidTradingAccount(data, userId) {
      return data.keys().hasAll(['accountId', 'userId', 'accountType', 'currency', 'balance', 'status'])
        && data.keys().hasOnly(['accountId', 'userId', 'accountType', 'currency', 'balance', 'startingBalance', 'status', 'createdAt', 'updatedAt'])
        && data.accountId is string && data.accountId.size() <= 32 && data.accountId.matches('^(ROT|DOT)[0-9]{6,12}$')
        && data.userId is string && data.userId == userId
        && data.accountType in ['real', 'demo']
        && data.currency is string && data.currency.size() <= 10
        && data.balance is number && data.balance >= 0
        && data.status in ['active', 'frozen'];
    }

    function isValidTrade(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'accountId', 'accountType', 'symbol', 'stake', 'status'])
        && data.keys().hasOnly(['id', 'userId', 'accountId', 'accountType', 'symbol', 'tradeType', 'direction', 'stake', 'payout', 'profitLoss', 'status', 'source', 'openedAt', 'closedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId
        && data.accountId is string && data.accountId.size() <= 32
        && data.accountType in ['real', 'demo']
        && data.symbol is string && data.symbol.size() <= 40
        && data.stake is number && data.stake > 0
        && data.status in ['open', 'closed'];
    }

    match /platform_config/{section} {
      allow get: if isValidId(section);
      allow list: if false;
      allow write: if isAdmin() && isValidId(section);
    }

    match /admins/{adminUid} {
      allow read, write: if false;
    }

    match /admin_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().status == 'active';
      allow update: if isValidId(userId) && isValidUserProfile(incoming(), userId) && (
        isAdmin() ||
        (isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().status == existing().status
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'country', 'phone', 'preferredTheme', 'preferredCurrency', 'updatedAt']))
      );
      allow delete: if isAdmin() && isValidId(userId);

      match /accounts/{accountId} {
        allow get: if isValidId(userId) && isValidId(accountId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(accountId) && (isOwner(userId) || isAdmin()) && isValidTradingAccount(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(accountId) && isValidTradingAccount(incoming(), userId) && (
          isAdmin() ||
          (isOwner(userId)
            && incoming().accountId == existing().accountId
            && incoming().userId == existing().userId
            && incoming().accountType == existing().accountType
            && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'currency', 'updatedAt']))
        );
        allow delete: if isAdmin() && isValidId(userId) && isValidId(accountId);
      }

      match /trades/{tradeId} {
        allow get: if isValidId(userId) && isValidId(tradeId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(tradeId) && (isOwner(userId) || isAdmin()) && isValidTrade(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(tradeId) && isValidTrade(incoming(), userId) && (
          isAdmin() ||
          (isOwner(userId) && existing().status == 'open' && incoming().diff(existing()).affectedKeys().hasOnly(['payout', 'profitLoss', 'status', 'closedAt']))
        );
        allow delete: if false;
      }

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin())
          && incoming().userId == userId
          && incoming().id is string && incoming().id.size() <= 128;
        allow update, delete: if false;
      }
    }
  }
}
