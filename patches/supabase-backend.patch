+-- Apply with Supabase SQL Editor or `supabase db push` after reviewing policies.
+create table if not exists public.profiles (
+  id uuid primary key references auth.users(id) on delete cascade,
+  email text not null,
+  full_name text not null default '',
+  role text not null default 'user' check (role in ('user', 'admin')),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+create table if not exists public.trades (
+  id uuid primary key default gen_random_uuid(),
+  user_id uuid not null references public.profiles(id) on delete cascade,
+  provider text not null check (provider = 'deriv'),
+  provider_contract_id text not null,
+  provider_transaction_id text,
+  symbol text not null,
+  contract_type text not null check (contract_type in ('CALL', 'PUT')),
+  stake numeric(20, 8) not null check (stake > 0),
+  currency char(3) not null,
+  status text not null check (status in ('open', 'won', 'lost', 'sold', 'unknown')),
+  created_at timestamptz not null default now(),
+  closed_at timestamptz,
+  unique (provider, provider_contract_id)
+);
+
+create table if not exists public.deriv_connections (
+  user_id uuid primary key references public.profiles(id) on delete cascade,
+  encrypted_token text not null,
+  updated_at timestamptz not null default now()
+);
+
+create table if not exists public.system_settings (
+  key text primary key check (key ~ '^[a-z][a-z0-9_]{1,63}$'),
+  value jsonb not null default '{}'::jsonb,
+  updated_at timestamptz not null default now()
+);
+
+-- Import only provider-confirmed commission statements. No commission is inferred
+-- from a user's submitted data or an estimated trading-volume multiplier.
+create table if not exists public.affiliate_commissions (
+  id uuid primary key default gen_random_uuid(),
+  provider_reference text not null unique,
+  user_id uuid references public.profiles(id) on delete set null,
+  amount numeric(20, 8) not null,
+  currency char(3) not null,
+  status text not null check (status in ('pending', 'confirmed', 'paid', 'reversed')),
+  source jsonb not null default '{}'::jsonb,
+  created_at timestamptz not null default now()
+);
+
+create index if not exists trades_user_created_idx on public.trades(user_id, created_at desc);
+create index if not exists commissions_created_idx on public.affiliate_commissions(created_at desc);
+
+alter table public.profiles enable row level security;
+alter table public.trades enable row level security;
+alter table public.deriv_connections enable row level security;
+alter table public.system_settings enable row level security;
+alter table public.affiliate_commissions enable row level security;
+
+-- User-facing browser access is intentionally read-only and owner-scoped. The
+-- Express service-role client performs privileged writes after validating auth.
+create policy "read own profile" on public.profiles for select to authenticated using (id = auth.uid());
+create policy "read own trades" on public.trades for select to authenticated using (user_id = auth.uid());
+create policy "read own commission records" on public.affiliate_commissions for select to authenticated using (user_id = auth.uid());
+-- No client policies for deriv_connections or system_settings.
+
+create or replace function public.create_profile_for_new_user()
+returns trigger language plpgsql security definer set search_path = '' as $$
+begin
+  insert into public.profiles (id, email, full_name)
+  values (new.id, coalesce(new.email, ''), coalesce(new.raw_user_meta_data ->> 'full_name', ''))
+  on conflict (id) do update set email = excluded.email;
+  return new;
+end;
+$$;
+
+drop trigger if exists on_auth_user_created_profile on auth.users;
+create trigger on_auth_user_created_profile after insert on auth.users
+for each row execute function public.create_profile_for_new_user();
*** End Patch

