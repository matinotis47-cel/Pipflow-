+import type { NextFunction, Response } from 'express';
+import { supabase } from '../lib/supabase.ts';
+import type { SupabaseRequest } from './verifySupabaseAuth.ts';
+
+export async function requireAdmin(req: SupabaseRequest, res: Response, next: NextFunction) {
+  if (!req.authUser) return res.status(401).json({ error: 'Authentication required.' });
+  try {
+    // Role is read from the protected profiles table, never from user-editable metadata.
+    const { data, error } = await supabase.from('profiles').select('role').eq('id', req.authUser.id).maybeSingle();
+    if (error) throw error;
+    if (data?.role !== 'admin') return res.status(403).json({ error: 'Administrator access required.' });
+    req.profileRole = data.role;
+    next();
+  } catch (error) {
+    next(error);
+  }
+}
