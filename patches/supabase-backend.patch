+import crypto from 'node:crypto';
+
+type DerivReply = { req_id?: number; error?: { message?: string; code?: string }; [key: string]: any };
+const APP_ID = process.env.DERIV_APP_ID;
+
+function encryptionKey(): Buffer {
+  const value = process.env.DERIV_TOKEN_ENCRYPTION_KEY || '';
+  if (!/^[\da-f]{64}$/i.test(value)) throw new Error('DERIV_TOKEN_ENCRYPTION_KEY must be 64 hex characters.');
+  return Buffer.from(value, 'hex');
+}
+
+export function encryptDerivToken(token: string): string {
+  const iv = crypto.randomBytes(12);
+  const cipher = crypto.createCipheriv('aes-256-gcm', encryptionKey(), iv);
+  const ciphertext = Buffer.concat([cipher.update(token, 'utf8'), cipher.final()]);
+  return `${iv.toString('base64url')}.${cipher.getAuthTag().toString('base64url')}.${ciphertext.toString('base64url')}`;
+}
+
+export function decryptDerivToken(value: string): string {
+  const [iv, tag, data] = value.split('.');
+  if (!iv || !tag || !data) throw new Error('Invalid encrypted Deriv token.');
+  const decipher = crypto.createDecipheriv('aes-256-gcm', encryptionKey(), Buffer.from(iv, 'base64url'));
+  decipher.setAuthTag(Buffer.from(tag, 'base64url'));
+  return Buffer.concat([decipher.update(Buffer.from(data, 'base64url')), decipher.final()]).toString('utf8');
+}
+
+async function request<T extends DerivReply>(token: string | undefined, payload: Record<string, unknown>): Promise<T> {
+  if (!APP_ID) throw new Error('Deriv integration is not configured.');
+  const socket = new WebSocket(`wss://ws.derivws.com/websockets/v3?app_id=${encodeURIComponent(APP_ID)}`);
+  const reqId = crypto.randomInt(1, 2 ** 30);
+  try {
+    const response = await new Promise<T>((resolve, reject) => {
+      const timer = setTimeout(() => reject(new Error('Deriv request timed out.')), 12000);
+      socket.addEventListener('open', () => {
+        if (token) socket.send(JSON.stringify({ authorize: token, req_id: reqId }));
+        else socket.send(JSON.stringify({ ...payload, req_id: reqId }));
+      }, { once: true });
+      socket.addEventListener('message', (event) => {
+        let body: DerivReply;
+        try { body = JSON.parse(String(event.data)); } catch { return; }
+        if (body.error) { clearTimeout(timer); reject(new Error(body.error.message || 'Deriv request rejected.')); return; }
+        if (token && body.msg_type === 'authorize') {
+          socket.send(JSON.stringify({ ...payload, req_id: reqId }));
+        } else if (body.req_id === reqId) { clearTimeout(timer); resolve(body as T); }
+      });
+      socket.addEventListener('error', () => { clearTimeout(timer); reject(new Error('Deriv connection failed.')); }, { once: true });
+    });
+    return response;
+  } finally { socket.close(); }
+}
+
+export async function verifyDerivToken(token: string) {
+  const result = await request<any>(token, { ping: 1 });
+  // The authorize reply is consumed before ping; response is intentionally minimal.
+  return result;
+}
+
+export async function executeDerivContract(input: {
+  token: string; symbol: string; contractType: 'CALL' | 'PUT'; amount: number;
+  currency: string; duration: number; durationUnit: 's' | 'm';
+}) {
+  const proposal = await request<any>(input.token, {
+    proposal: 1, amount: input.amount, basis: 'stake', contract_type: input.contractType,
+    currency: input.currency, duration: input.duration, duration_unit: input.durationUnit,
+    symbol: input.symbol,
+  });
+  const proposalId = proposal.proposal?.id;
+  if (typeof proposalId !== 'string') throw new Error('Deriv did not return a trade proposal.');
+  const result = await request<any>(input.token, { buy: proposalId, price: input.amount });
+  const contractId = result.buy?.contract_id;
+  if (!contractId) throw new Error('Deriv did not confirm the contract purchase.');
+  return { contractId: String(contractId), transactionId: result.buy?.transaction_id ? String(result.buy.transaction_id) : null };
+}
*** End Patch

