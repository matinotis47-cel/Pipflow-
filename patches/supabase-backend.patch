+import { Router } from 'express';
+import { z } from 'zod';
+import { supabase, assertDbOk } from '../lib/supabase.ts';
+import { verifySupabaseAuth, type SupabaseRequest } from '../middleware/verifySupabaseAuth.ts';
+import { decryptDerivToken, encryptDerivToken, executeDerivContract } from '../services/deriv.ts';
+
+const router = Router();
+router.use(verifySupabaseAuth);
+
+const linkSchema = z.object({ accessToken: z.string().min(20).max(4096) }).strict();
+router.post('/deriv/link', async (req: SupabaseRequest, res, next) => {
+  const parsed = linkSchema.safeParse(req.body);
+  if (!parsed.success) return res.status(400).json({ error: 'A valid Deriv access token is required.' });
+  try {
+    // Persist only authenticated, encrypted user tokens; never return token material.
+    const encrypted = encryptDerivToken(parsed.data.accessToken);
+    assertDbOk(await supabase.from('deriv_connections').upsert({ user_id: req.authUser!.id, encrypted_token: encrypted, updated_at: new Date().toISOString() }));
+    res.status(204).end();
+  } catch (error) { next(error); }
+});
+
+router.delete('/deriv/link', async (req: SupabaseRequest, res, next) => {
+  try {
+    assertDbOk(await supabase.from('deriv_connections').delete().eq('user_id', req.authUser!.id));
+    res.status(204).end();
+  } catch (error) { next(error); }
+});
+
+const executionSchema = z.object({
+  symbol: z.string().regex(/^[A-Z0-9_]{2,32}$/),
+  contractType: z.enum(['CALL', 'PUT']), amount: z.number().positive().max(10000),
+  currency: z.string().regex(/^[A-Z]{3}$/), duration: z.number().int().min(1).max(86400),
+  durationUnit: z.enum(['s', 'm']),
+}).strict();
+
+router.post('/execute', async (req: SupabaseRequest, res, next) => {
+  const parsed = executionSchema.safeParse(req.body);
+  if (!parsed.success) return res.status(400).json({ error: 'Invalid execution request.', issues: parsed.error.issues });
+  try {
+    const connection = assertDbOk(await supabase.from('deriv_connections').select('encrypted_token').eq('user_id', req.authUser!.id).maybeSingle());
+    if (!connection) return res.status(409).json({ error: 'Link a Deriv account before trading.' });
+    const token = decryptDerivToken(connection.encrypted_token);
+    const execution = await executeDerivContract({ ...parsed.data, token });
+    const trade = assertDbOk(await supabase.from('trades').insert({
+      user_id: req.authUser!.id, provider: 'deriv', provider_contract_id: execution.contractId,
+      provider_transaction_id: execution.transactionId, symbol: parsed.data.symbol,
+      contract_type: parsed.data.contractType, stake: parsed.data.amount, currency: parsed.data.currency,
+      status: 'open',
+    }).select('id,provider_contract_id,symbol,contract_type,stake,currency,status,created_at').single());
+    // Commission amounts are reconciled from provider statements, never fabricated from volume.
+    res.status(201).json({ trade });
+  } catch (error) { next(error); }
+});
+
+router.get('/trades', async (req: SupabaseRequest, res, next) => {
+  try {
+    const trades = assertDbOk(await supabase.from('trades').select('id,provider,symbol,contract_type,stake,currency,status,created_at,closed_at').eq('user_id', req.authUser!.id).order('created_at', { ascending: false }).limit(100));
+    res.json({ trades });
+  } catch (error) { next(error); }
+});
+
+export default router;
*** End Patch

