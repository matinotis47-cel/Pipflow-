+import 'dotenv/config';
+import { createClient } from '@supabase/supabase-js';
+
+const url = process.env.SUPABASE_URL;
+const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;
+if (!url || !serviceRoleKey) {
+  throw new Error('SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are required.');
+}
+
+// Server-only administrative client. Every request must still be authorized in
+// Express; the service role bypasses RLS and must never reach the browser.
+export const supabase = createClient(url, serviceRoleKey, {
+  auth: { autoRefreshToken: false, persistSession: false, detectSessionInUrl: false },
+  global: { headers: { 'X-Client-Info': 'pipflow-server' } },
+});
+
+export function assertDbOk<T>(result: { data: T; error: { message: string } | null }): T {
+  if (result.error) throw new Error(`Supabase request failed: ${result.error.message}`);
+  return result.data;
+}
