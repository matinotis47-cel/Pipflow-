{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered PIPFLOW trader profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "fullName": { "type": "string", "maxLength": 120 },
        "country": { "type": "string", "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 40 },
        "emailVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "preferredTheme": { "type": "string", "enum": ["light", "dark"] },
        "preferredCurrency": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "status", "createdAt"]
    },
    "TradingAccount": {
      "title": "TradingAccount",
      "description": "User Real (ROT...) or Demo (DOT...) trading account",
      "type": "object",
      "properties": {
        "accountId": { "type": "string", "pattern": "^(ROT|DOT)[0-9]{6,12}$", "maxLength": 32 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "accountType": { "type": "string", "enum": ["real", "demo"] },
        "currency": { "type": "string", "maxLength": 10 },
        "balance": { "type": "number" },
        "startingBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "frozen"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountId", "userId", "accountType", "currency", "balance", "status"]
    },
    "TradeRecord": {
      "title": "TradeRecord",
      "description": "Simulated trade executed manually or by AI profit-only bot",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "accountId": { "type": "string", "maxLength": 32 },
        "accountType": { "type": "string", "enum": ["real", "demo"] },
        "symbol": { "type": "string", "maxLength": 40 },
        "tradeType": { "type": "string", "maxLength": 40 },
        "direction": { "type": "string", "maxLength": 20 },
        "stake": { "type": "number" },
        "payout": { "type": "number" },
        "profitLoss": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "source": { "type": "string", "enum": ["manual", "bot", "ai_profit_bot", "bulk", "copy"] },
        "openedAt": { "type": "string", "format": "date-time" },
        "closedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "accountId", "accountType", "symbol", "stake", "status"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "Ledger entry for virtual credits, debits, resets, and trade settlements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "accountId": { "type": "string", "maxLength": 32 },
        "accountType": { "type": "string", "enum": ["real", "demo"] },
        "type": { "type": "string", "enum": ["credit", "debit", "reset", "trade_win", "trade_loss", "pnl_adjustment"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "accountId", "type", "amount", "balanceAfter", "createdAt"]
    },
    "PlatformConfig": {
      "title": "PlatformConfig",
      "description": "Central PIPFLOW branding, theme, feature, market, and website settings",
      "type": "object",
      "properties": {
        "section": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["section", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable log of administrator actions and login attempts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 120 },
        "actor": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "actor", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document isolated to owner or admin"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/TradingAccount" },
      "description": "User Real (ROT...) and Demo (DOT...) accounts"
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/TradeRecord" },
      "description": "User trading activity and settlements"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/TransactionRecord" },
      "description": "User account transaction ledger"
    },
    "/platform_config/{section}": {
      "schema": { "$ref": "#/entities/PlatformConfig" },
      "description": "Publicly readable platform branding, theme, and feature flags; admin-only writes"
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Admin-only audit trail"
    }
  }
}
